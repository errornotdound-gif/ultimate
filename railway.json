{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "mkdir -p logs"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "php -S 0.0.0.0:8080 mailer.php",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "healthcheckInterval": 60
  }
}